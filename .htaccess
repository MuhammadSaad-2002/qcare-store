Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:_private|release)(?:/|$) - [F,L,NC]
RewriteRule ^(?:deploy\.(?:php|sh)|.*\.(?:sql|sqlite|log|bak|ini|env|yml|yaml|tar|gz|zip))$ - [F,L,NC]
RewriteCond %{HTTP_HOST} ^store\.qcare-pharmacy\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://store.qcare-pharmacy.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<FilesMatch "^(?:\.env.*|\.git.*|deploy\..*|composer\..*|package.*)$">
Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "^(?:app|chunk|styles)\.[a-f0-9]{12}\.(?:js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
